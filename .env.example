# TSI Nexus - Environment Configuration
# Copy this file to .env and edit the values before running docker compose.

# ── Port mapping ─────────────────────────────────────────────────────────────
# Format: HOST_PORT:CONTAINER_PORT
APP_PORT_MAP=8084:8080
DB_PORT_MAP=5436:5432

# ── LLM provider ─────────────────────────────────────────────────────────────
# Supported providers: openai-compatible, openai, claude, gemini, sarvam
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://192.168.1.77:8001
LLM_MODEL=gemma-4-26B-A4B-it
LLM_API_KEY=

# Optional provider-specific overrides.
# LLM_CHAT_PATH=/v1/chat/completions
# LLM_AUTH_HEADER=api-subscription-key
# LLM_API_VERSION=2023-06-01

# Legacy vLLM names are still accepted by the app when LLM_* is not set.
# VLLM_URL=http://192.168.1.77:8001
# VLLM_MODEL=gemma-4-26B-A4B-it

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=tsi_nexus
POSTGRES_USER=tsi_admin
POSTGRES_PASSWD=secure_dev_password        # Change for production

# ── Security ──────────────────────────────────────────────────────────────────
# JWT signing secret — REQUIRED. Generate with: openssl rand -hex 32
TSI_NEXUS_JWT_SECRET=REPLACE_WITH_YOUR_OWN_SECRET

# ── Export path (inside container) ────────────────────────────────────────────
TSI_EXPORT_PATH=/var/lib/tsi/exports/

# ── Environment label (informational, shown in server logs) ───────────────────
TSI_PRIVACY_VAULT_ENV=development
