<?xml version="1.0" ?>
<web-app
		xmlns = "https://jakarta.ee/xml/ns/jakartaee"
		xmlns:xsi = "http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation = "https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
		version = "5.0"
		metadata-complete = "false">
<filter>
	<filter-name>TSI_Nexus</filter-name>
	<filter-class>org.tsicoop.nexus.framework.InterceptingFilter</filter-class>
</filter>
	
<filter-mapping>
	<filter-name>TSI_Nexus</filter-name>
	<url-pattern>/api/*</url-pattern>
	<dispatcher>REQUEST</dispatcher>
	<dispatcher>FORWARD</dispatcher>
</filter-mapping>

<!--
  Server-side gate for the static console pages. Previously they were served to any HTTP
  client, relying on client-side JS to redirect after the page had been delivered.
  Requires the session cookie set at login (see User.handleAuth).
  Login pages (/admin/index.html, /liquid/index.html) are exempted inside the filter.
-->
<filter>
	<filter-name>CONSOLE_AUTH_FILTER</filter-name>
	<filter-class>org.tsicoop.nexus.framework.ConsoleAuthFilter</filter-class>
</filter>

<filter-mapping>
	<filter-name>CONSOLE_AUTH_FILTER</filter-name>
	<url-pattern>/admin/*</url-pattern>
	<url-pattern>/onboard/*</url-pattern>
	<url-pattern>/seed/*</url-pattern>
	<url-pattern>/liquid/*</url-pattern>
	<dispatcher>REQUEST</dispatcher>
	<dispatcher>FORWARD</dispatcher>
</filter-mapping>

<!-- Overrides dirAllowed=true from Jetty's webdefault so directories with no welcome file are not listed. -->
<servlet>
	<servlet-name>default</servlet-name>
	<servlet-class>org.eclipse.jetty.ee10.servlet.DefaultServlet</servlet-class>
	<init-param>
		<param-name>dirAllowed</param-name>
		<param-value>false</param-value>
	</init-param>
</servlet>

<welcome-file-list>
	<welcome-file>index.html</welcome-file>
</welcome-file-list>
</web-app>
